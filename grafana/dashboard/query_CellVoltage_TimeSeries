### Query 1 - Maximum Cell Voltage

carFilter = "${car}"
ownershipFilter = "${ownership}"

from(bucket: "carscanner_tagged")
  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)
  |> filter(fn: (r) => r["_measurement"] == "carscanner")
  |> filter(fn: (r) => r["_field"] == "[BMS] Maximum Cell Voltage (V)")
  |> filter(fn: (r) => r.car == carFilter)
  |> filter(fn: (r) => r.ownership == ownershipFilter)
  |> drop(columns: ["trip"])
  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)
  |> yield(name: "max")


### Query 2 - Minimum Cell Voltage

from(bucket: "carscanner_tagged")
  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)
  |> filter(fn: (r) => r["_measurement"] == "carscanner")
  |> filter(fn: (r) => r["_field"] == "[BMS] Minimum Cell Voltage (V)")
  |> drop(columns: ["trip"])
  |> aggregateWindow(every: v.windowPeriod, fn: min, createEmpty: false)
  |> yield(name: "min")
